# Copy this file to .env and fill in real values. Never commit .env.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas → Connect → Drivers → copy the connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/stockwatch

# Finnhub dashboard → API key
FINNHUB_API_KEY=

# Firebase console → Project settings → Service accounts → Generate new private key.
# Copy these three fields from the downloaded JSON (keep the quotes around the private key).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: email delivery for alerts. Leave blank to show triggered alerts in the app only.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
# SMTP_PASS=<16-character app password from myaccount.google.com/apppasswords>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="StockWatch <you@gmail.com>"
