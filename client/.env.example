# Copy this file to .env.local and fill in values from
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration.
# These identify your Firebase project; they are not secret, but keep them out of git anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Leave empty in development (Vite proxies /api). Set to your deployed Express URL in production.
VITE_API_URL=
